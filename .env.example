# Скопируйте в .env и заполните. Файл .env в git не попадает (см. .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Telegram ID пользователей, которым разрешён доступ, через запятую.
# Свой ID можно узнать у @userinfobot
USER_IDS=

# Сохранять исходные аудиофайлы для отладки: 1 — да, 0 — нет
DEBUG=0
